set shell := ["bash", "-euo", "pipefail", "-c"]

root := justfile_directory() / ".."
schema := root / "target" / "ffier-ft.json"
foreign_schema := root / "target" / "ffier-fl.json"

# Run all tests
default: no-codegen check-cfg-library-entry check-header platform-cfg compile-fail conditional-bridge valgrind miri consumer rust-client compat cargo-test
    @echo ""
    @echo "All checks passed!"

# Build the foreign lib (produces cdylib + writes target/ffier-fl.json)
build-foreign:
    cargo rustc --manifest-path {{root}}/Cargo.toml -p ffier-test-foreign-lib --crate-type cdylib

# Build the test lib (also produces the cdylib + writes target/ffier-ft.json)
build: build-foreign
    cargo rustc --manifest-path {{root}}/Cargo.toml -p ffier-test-lib --crate-type cdylib

# Generate the C header into target/
gen-header: build
    cargo run --manifest-path {{root}}/Cargo.toml -p ffier-gen-c-header -- {{schema}} FFIER_FT_H > {{root}}/target/ffier_test.h

# Compile the generated header without additional includes.
check-header: gen-header
    cc -std=c11 -Wall -Wextra -Werror -x c -fsyntax-only {{root}}/target/ffier_test.h

# Compile and run the C tests
c: build gen-header
    cc -Wall -Wextra -Werror -g -o {{root}}/target/c_test_main c/test_main.c \
        -I {{root}}/target \
        -L {{root}}/target/debug \
        -lffier_test_lib \
        -lffier_test_foreign_lib \
        -Wl,-rpath,{{root}}/target/debug \
        -Wl,--disable-new-dtags
    {{root}}/target/c_test_main
    # Expected aborts bypass cleanup; check them outside the Valgrind run.
    {{root}}/target/c_test_main --payload-abort-tests

# Run C tests under valgrind
valgrind: c
    valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes --error-exitcode=1 \
        {{root}}/target/c_test_main

# Run Miri with Stacked Borrows (default model)
miri-stacked:
    cargo +nightly miri test --manifest-path {{root}}/Cargo.toml -p ffier-test-lib

# Run Miri with Tree Borrows
miri-tree:
    MIRIFLAGS="-Zmiri-tree-borrows" cargo +nightly miri test --manifest-path {{root}}/Cargo.toml -p ffier-test-lib

# Run Miri with both memory models
miri: miri-stacked miri-tree

# Test consumer crate with native Rust linking
consumer-native: build
    cargo test --manifest-path {{root}}/Cargo.toml -p ffier-test-consumer --no-default-features --features native

# Test consumer crate with C ABI dynamic linking
consumer-cdylib: build
    cargo test --manifest-path {{root}}/Cargo.toml -p ffier-test-consumer --no-default-features --features via-cdylib

# Test consumer crate in both linking modes
consumer: consumer-native consumer-cdylib

# Run the same wrapper/callback suite in separate Cargo invocations so other
# workspace dependencies cannot silently enable strong on the dynlookup test.
rust-client: build
    cargo test --manifest-path {{root}}/Cargo.toml -p ffier-test-lib-via-cdylib
    cargo test --manifest-path {{root}}/Cargo.toml -p ffier-test-lib-via-cdylib --no-default-features --features strong
    cargo test --manifest-path {{root}}/Cargo.toml -p ffier-test-lib-via-cdylib --features dynlookup,strong
    python3 client-linking/check.py

# Run vtable backward-compatibility tests (v1 client → v2 library)
compat: build
    cargo test --manifest-path {{root}}/Cargo.toml -p ffier-test-compat

# Verify the test lib compiles without FFI (no codegen, pure Rust types).
# Compilation alone proves no FFI symbols leak: library_definition! and
# all #[ffier::export] annotations are cfg-gated behind feature = "ffi".
no-codegen: build-foreign
    cargo check --manifest-path {{root}}/Cargo.toml -p ffier-test-lib --no-default-features
    cargo test --manifest-path {{root}}/Cargo.toml -p ffier-test-lib --no-default-features fieldless_error_client_tests

# Verify cfg-gated entries are PRESENT in the schema with a "cfg" field
# even when the feature is off but FFI codegen is still enabled.
check-cfg-library-entry: build-foreign
    cargo build --manifest-path {{root}}/Cargo.toml -p ffier-test-lib --no-default-features --features ffi,fruit-label
    python3 check_schema.py "{{schema}}"

# Run all Rust tests
cargo-test: build
    cargo test --manifest-path {{root}}/Cargo.toml

# Verify compile-fail fixture diagnostics.
compile-fail:
    python3 compile-fail/check.py

# Expand with the same a_feature enabled in all three crates, then disabled in all.
conditional-bridge: conditional-bridge-enabled conditional-bridge-disabled

# Forward bridge -> facade -> provider features and call the exported C functions.
conditional-bridge-enabled:
    cargo test --offline --manifest-path conditional-bridge/Cargo.toml \
        --target-dir {{root}}/target/conditional-bridge -p conditional-bridge \
        --features a_feature

# With all three features disabled, the cdylib must export no Widget bridge functions.
conditional-bridge-disabled:
    cargo build --offline --manifest-path conditional-bridge/Cargo.toml \
        --target-dir {{root}}/target/conditional-bridge -p conditional-bridge
    nm --dynamic --defined-only {{root}}/target/conditional-bridge/debug/libconditional_bridge.so \
        > {{root}}/target/conditional-bridge/disabled-symbols.txt
    ! grep ' conditional_widget_' {{root}}/target/conditional-bridge/disabled-symbols.txt

# Render generated-artifact diffs against a base ref (default origin/main).
# Writes to stdout; GitHub Actions appends to the job summary.
codegen-diff base="origin/main":
    python3 render-codegen-diff.py {{base}}

# Compile both target-specific signatures and preserve conditional vtable slots.
platform-cfg:
    cargo rustc --manifest-path {{root}}/Cargo.toml -p ffier-test-windows-handles --crate-type cdylib
    cargo test --manifest-path {{root}}/Cargo.toml -p ffier-test-windows-handles-client
    cargo test --manifest-path {{root}}/Cargo.toml -p ffier-test-windows-handles-client --no-default-features --features dynlookup
    cargo test --manifest-path {{root}}/Cargo.toml -p ffier-test-windows-handles-client --features dynlookup,strong
    cargo run --manifest-path {{root}}/Cargo.toml -p ffier-gen-c-header -- {{root}}/target/ffier-windows-handles.json FFIER_PLATFORM_H --fn-typedefs > {{root}}/target/platform.h
    cc -std=c11 -Wall -Wextra -Werror -x c -fsyntax-only {{root}}/target/platform.h
    cc -std=c11 -Wall -Wextra -Werror -I {{root}}/target -fsyntax-only c/platform.c
